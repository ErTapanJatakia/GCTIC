# ---------------------------------------------------------------------------
# GCTIC — environment configuration template
#
# Copy to `.env.local` for local overrides. `.env*` files are git-ignored.
#
# SECURITY: any variable prefixed with VITE_ is compiled into the browser
# bundle and is therefore PUBLIC. Never place API keys, tokens, credentials,
# feed subscription secrets or internal hostnames here. Those belong in
# server-side environment variables consumed by a backend service (see
# README "Configuration").
# ---------------------------------------------------------------------------

# Optional. Label shown in the header environment badge.
# Defaults to the detected runtime mode (local development / build).
VITE_GCTIC_ENV_LABEL=

# Optional. Base URL of a future intelligence API gateway / backend.
# Leave empty while the frontend runs against local foundation data only.
# Must be an absolute http(s) origin, e.g. http://localhost:8787
VITE_GCTIC_API_BASE_URL=
